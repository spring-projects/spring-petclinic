pipeline {
    agent {
        label 'maven'
    }
    tools {
        maven 'Maven'
    }
    environment {
        DOCKER_HOST = 'tcp://docker:2376'
        DOCKER_TLS_VERIFY = '1'
        DOCKER_CERT_PATH = '/certs/client'
        DEPLOY_HOST = '178.154.250.190'
    }
    stages {
        stage('Check Docker') {
            steps {
                sh '''
                    command -v docker
                    docker version
                '''
            }
        }
        stage('Build') {
            steps {
                sh 'mvn -B clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn -B test'
            }
        }
	
	stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE_TAG = "sha-${env.GIT_COMMIT.take(12)}"
                }
                sh 'docker build -t petclinic:$IMAGE_TAG .'
            }
        }
        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT
        
                        printf '%s' "$DOCKERHUB_TOKEN" |
                            docker login docker.io \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin
        
                        docker tag "petclinic:$IMAGE_TAG" \
                            "anxlime/petclinic:$IMAGE_TAG"
        
                        docker push "anxlime/petclinic:$IMAGE_TAG"
                    '''
                }
            }
        }
        stage('Deploy') {
            when {
                branch 'main'
            }
        
            steps {
                sshagent(credentials: ['yandex-vm']) {
                    sh '''
                        set -eu
        
                        DEPLOY_MANIFEST="$(mktemp)"
                        trap 'rm -f "$DEPLOY_MANIFEST"' EXIT
        
                        sed "s|image: anxlime/petclinic:.*|image: anxlime/petclinic:$IMAGE_TAG|" \
                            deploy/manifests/petclinic.yaml > "$DEPLOY_MANIFEST"
        
                        scp \
                            -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            -o UserKnownHostsFile=infra/known_hosts \
                            "$DEPLOY_MANIFEST" \
                            "ubuntu@$DEPLOY_HOST:/tmp/petclinic-$IMAGE_TAG.yaml"
        
                        ssh \
                            -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            -o UserKnownHostsFile=infra/known_hosts \
                            "ubuntu@$DEPLOY_HOST" \
                            "sudo k3s kubectl apply -f /tmp/petclinic-$IMAGE_TAG.yaml &&
                             sudo k3s kubectl -n petclinic rollout status deployment/petclinic --timeout=300s &&
                             curl --fail --silent --show-error \
                                 --connect-timeout 5 --max-time 10 \
                                 --retry 12 --retry-delay 5 --retry-max-time 120 \
                                 --retry-connrefused \
                                 http://127.0.0.1/ >/dev/null &&
			     rm -f /tmp/petclinic-$IMAGE_TAG.yaml"
                    '''
                }
            }
        }
    }
    post {
        always {
            junit testResults: 'target/surefire-reports/*.xml',
                  allowEmptyResults: true
        }
        success {
            archiveArtifacts artifacts: 'target/spring-petclinic-*.jar',
                             fingerprint: true
        }
    }
}
