              "type": "tm.Store",
              "name": "D1\nBase de datos",
              "description": "Tablas owners, pets, visits, vets, specialties y types. Contiene datos personales de los dueños.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "15fa0c9d-ebbc-5b00-a31c-c58c6ae7ea00",
                  "title": "Cambios en datos personales sin registro del autor",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "",
                  "description": "Como no hay autenticación ni auditoría, no se puede saber quién creó o modificó un dueño, una mascota o una visita. Impacto: Medio. Probabilidad: Media. Prioridad: Media.",
                  "mitigation": "Tras autenticar, registrar usuario, acción, identificador del registro y hora en un log de auditoría, sin incluir datos personales. Trazabilidad: ASVS #21 (V7.2.2), #15 (V7.1.1), #19 (V2.1.1). Control: Revisión manual."
                },
                {
                  "id": "6f1554c1-436e-5d68-a511-120baebb5224",
                  "title": "Credenciales de la base de datos en claro en el repositorio",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": "",
                  "description": "docker-compose.yml y k8s/db.yml guardan usuario y contraseña de desarrollo (petclinic y pass) y MySQL admite root sin contraseña. Quien acceda al repositorio o al clúster podría conectarse a la base. Impacto: Alto. Probabilidad: Media. Prioridad: Alta.",
                  "mitigation": "Mover las credenciales a secretos del CI y a un Secret de Kubernetes real, sin valores en el repositorio, y retirar MYSQL_ALLOW_EMPTY_PASSWORD. Trazabilidad: ASVS #11 (V2.10.4). Control: Gitleaks (job secretos); IaC con Checkov (pendiente)."
                }
              ],
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": false
            }
