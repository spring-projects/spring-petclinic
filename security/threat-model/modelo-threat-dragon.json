                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Tampering",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "",
                  "description": "Un atacante envía campos adicionales, como id, para sobrescribir registros de otra entidad. Impacto: Alto. Probabilidad: Baja. Prioridad: Media.",
