              "threats": [
                {
                  "id": "4aaa3222-065d-57dd-aa82-db4abe2a2dcf",
                  "title": "Exposición de endpoints de administración (Actuator)",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Information disclosure",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": "",
                  "description": "Con management.endpoints.web.exposure.include=* se publicarían endpoints como env, heapdump o beans. Se detectó en el PR #1 y se corrigió en el PR #2. Impacto: Alto. Probabilidad: Baja. Prioridad: Media.",
                  "mitigation": "Se limitó la exposición a health e info en application.properties. Trazabilidad: ASVS #10 (V14.3.2). Control: Semgrep con regla propia petclinic-actuator-wildcard-exposure (job sast, activa)."
                }
              ],
              "hasOpenThreats": false
            }
