                {
                  "id": "d6397c90-3297-5f69-a31e-99fe76bf7989",
                  "title": "Robo de sesión por cookie sin atributos de protección",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "",
                  "description": "La aplicación crea sesión para los mensajes de las redirecciones. Sin TLS ni los atributos Secure y SameSite, un atacante en la red puede capturar la cookie JSESSIONID y reutilizarla. Impacto: Medio. Probabilidad: Media. Prioridad: Media.",
                  "mitigation": "Servir solo por HTTPS, configurar server.servlet.session.cookie.secure=true y same-site=lax, y regenerar la sesión al autenticar. Trazabilidad: ASVS #20 (V3.4.1 a V3.4.3), #7 (V9.1.1). Control: ZAP baseline (pendiente); IaC con Checkov sobre k8s (pendiente)."
                }
              ],
